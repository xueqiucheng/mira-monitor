# ============================================================================
# Mira Monitor — 环境变量样板
# 用法：cp .env.example .env.local 然后填值
# 上线时把这些 key 配到 Railway 项目的 Variables（不要写进 git）
# ============================================================================

# ---------- Basic Auth（middleware 强校验，留空就跑不起来）-----------------
# 不配 pass 服务会拒绝所有非 /api/health 请求，避免误把无认证 dashboard 上线
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASS=

# ---------- PostHog（业务指标 DAU/MAU/新增/任务/消息）-----------------------
# PostHog → Account Settings → Personal API Keys
# scope 勾 "Performing analytics queries"
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://us.posthog.com

# ---------- Langfuse（LLM token / cost / 模型分布 / 工具调用）--------------
# Langfuse 项目 → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Sentry（错误率 / SLA / Web Vitals / Crash-free）----------------
# Sentry → Account Settings → Auth Tokens
# ⚠ 必须 User Auth Token（sntryu_ 前缀），勾 event:read + org:read + project:read
# ⚠ 不能用 Org Auth Token（sntrys_）
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------- Railway（部署状态 + commit + 版本，读用，不是 deploy token）----
# Railway → Project Settings → Tokens（账号级 token 也行，只读 GraphQL）
# ⚠ 必须加 _DATASOURCE_ 前缀：Railway 平台会自动注入 RAILWAY_PROJECT_ID / RAILWAY_ENVIRONMENT_ID
#    指向"本服务自己所在的 project"，跟我们想读的"被监控 mira 主站"撞名。
# 填值时指向被监控目标（通常是 mira 主站）的 project / env / readonly token。
RAILWAY_DATASOURCE_TOKEN=
RAILWAY_DATASOURCE_PROJECT_ID=
RAILWAY_DATASOURCE_ENVIRONMENT_ID=

# ---------- 心跳目标 -------------------------------------------------------
MIRA_HEALTH_URL=https://mira.day/api/health

# ============================================================================
# Cost ingest (费用监控) — 配齐后 Cost Tab 由 mock 切换为真数据
# 每日 0:30 北京时间由 Railway sibling cron service POST /api/ingest/cost 触发
# 落到 Postgres 4 张表(cost_*_daily),web service 渲染 Cost Tab 时读这些表
# ============================================================================

# Railway 平台自动注入(在 service 关联了 Postgres 之后),本地开发用 Railway CLI 注入或手填
DATABASE_URL=

# Web 服务用于校验 ingest endpoint 的 bearer token;cron service 拿同一份调用
# 没配的话 ingest endpoint 返 503,避免无认证接口被刷
COST_INGEST_TOKEN=

# Vercel AI Gateway(LLM cost + 余额 + token 拆分 + Top 模型)
AI_GATEWAY_API_KEY=

# Exa(搜索 API,按 price_id 拆 cost)
# EXA_API_KEY_IDS 是 admin-api.exa.ai 上每个 API key 的 id,逗号分隔
EXA_SERVICE_KEY=
EXA_API_KEY_IDS=

# Apollo(GraphQL endpoint 调用统计,API 不返金额所以 estimated_cost_usd 可空)
APOLLO_MASTER_API_KEY=

# 复用上面的 RAILWAY_DATASOURCE_TOKEN 拉 estimatedUsage,无需新增
